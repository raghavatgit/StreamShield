{
  "productName": "StreamShield",
  "version": "0.2.0",
  "identifier": "com.streamshield",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "StreamShield",
        "width": 540,
        "height": 780,
        "minWidth": 460,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-features=CalculateNativeWinOcclusion,IntensiveWakeUpThrottling"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Raghav Goyal",
    "copyright": "Copyright © 2026 Raghav Goyal. All rights reserved.",
    "shortDescription": "Stream Privacy Manager",
    "longDescription": "Selectively shield individual application windows from stream and OBS capture.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}